# Builds the public frontend and the admin panel, then serves both
# (plus a reverse proxy to the backend) via Caddy with automatic HTTPS.

FROM node:20-alpine AS frontend-build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ ./
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build
RUN npm run build:ssr

FROM node:20-alpine AS admin-build
WORKDIR /app
COPY admin/package*.json ./
RUN npm ci --legacy-peer-deps
COPY admin/ ./
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM caddy:2-alpine AS caddy-web
COPY --from=admin-build /app/dist /srv/admin
COPY Caddyfile /etc/caddy/Caddyfile

FROM node:20-alpine AS frontend-ssr
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --omit=dev --legacy-peer-deps
COPY --from=frontend-build /app/dist ./dist
COPY --from=frontend-build /app/dist-server ./dist-server
COPY frontend/server.mjs ./server.mjs
EXPOSE 3000
CMD ["node", "server.mjs"]
