# --- Домены (DNS должен указывать на IP этого VPS) ---
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com

# --- Публичный URL API, который зашивается во фронт и админку при сборке ---
VITE_API_URL=https://example.com/api

# --- База данных (Postgres внутри docker-сети) ---
POSTGRES_USER=suvarna
POSTGRES_PASSWORD=change-me
POSTGRES_DB=suvarna

# --- Backend ---
PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# --- ЮKасса ---
YOKASSA_SHOP_ID=your-shop-id
YOKASSA_SECRET_KEY=your-secret-key
APP_URL=https://example.com

# --- Уведомления о новых заказах через Яндекс Почту ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info@iamsuvarna.ru
SMTP_PASSWORD_B64=base64-encoded-yandex-app-password
ORDER_NOTIFICATION_EMAIL=info@iamsuvarna.ru

# --- Долями (BNPL, T-Банк) ---
# Боевой URL API (тестовые заказы T-Банк тоже проводит на нём с тест-доступами)
DOLYAME_BASE_URL=https://partner.dolyame.ru/v1
DOLYAME_LOGIN=your-dolyame-login
DOLYAME_PASSWORD=your-dolyame-password
# Запустить scripts/configure-dolyame-ca.sh для создания корректного CA bundle
NODE_EXTRA_CA_CERTS=/app/secrets/russian-trusted-ca-bundle.pem
# Пути к mTLS-сертификату и приватному ключу внутри контейнера бэкенда
DOLYAME_CERT_PATH=/app/secrets/dolyame-cert.pem
DOLYAME_KEY_PATH=/app/secrets/dolyame-key.pem
