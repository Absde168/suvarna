# Redirect www -> canonical (non-www)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# API -> backend
	handle /api/* {
		reverse_proxy backend:4000
	}

	# Dynamic sitemap -> backend
	handle /sitemap.xml {
		rewrite * /api/sitemap.xml
		reverse_proxy backend:4000
	}

	# SSR frontend, including the built static assets served by its Node process
	handle {
		reverse_proxy frontend:3000
	}

	encode gzip
}

{$ADMIN_DOMAIN} {
	root * /srv/admin
	try_files {path} /index.html
	file_server
	encode gzip
}
